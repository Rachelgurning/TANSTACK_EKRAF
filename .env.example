# Copy this file to .env.local and set real values locally. Never commit .env.local.
BETTER_AUTH_URL=http://localhost:3000
# Generate a unique secret, e.g. `bunx @better-auth/cli secret`
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional server-only AI key; never use a VITE_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
